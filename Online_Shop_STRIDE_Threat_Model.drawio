        </mxCell>
        <mxCell id="t_tamper" value="T • TAMPERING&lt;br&gt;&lt;b&gt;Alter basket, price, order or stock&lt;/b&gt;&lt;br&gt;Could cause fraud or incorrect fulfilment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A300;fontColor=#202124;fontSize=14;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1">
