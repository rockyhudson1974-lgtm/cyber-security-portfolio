        </mxCell>
        <mxCell id="r_repud" value="R • REPUDIATION&lt;br&gt;&lt;b&gt;Order action later denied&lt;/b&gt;&lt;br&gt;Weak audit records hinder dispute checks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontColor=#202124;fontSize=14;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1">
