        </mxCell>
        <mxCell id="d_dos" value="D • DENIAL OF SERVICE&lt;br&gt;&lt;b&gt;Flood app, login or checkout&lt;/b&gt;&lt;br&gt;Customers cannot shop; sales are lost." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C0504D;fontColor=#202124;fontSize=14;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1">
