        </mxCell>
        <mxCell id="i_info" value="I • INFORMATION DISCLOSURE&lt;br&gt;&lt;b&gt;Expose credentials, payment or personal data&lt;/b&gt;&lt;br&gt;Could enable fraud and harm privacy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontColor=#202124;fontSize=14;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1">
